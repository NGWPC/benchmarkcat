FROM python:3.12-slim

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

# Install terraform + system deps
RUN apt-get update && apt-get install -y --no-install-recommends \
        curl unzip gnupg \
    && curl -fsSL https://releases.hashicorp.com/terraform/1.14.7/terraform_1.14.7_linux_amd64.zip -o tf.zip \
    && unzip tf.zip -d /usr/local/bin && rm tf.zip \
    && rm -rf /var/lib/apt/lists/*

# Install AWS CLI
RUN pip install --no-cache-dir awscli

WORKDIR /app

COPY requirements-orchestration.txt .
RUN pip install --no-cache-dir -r requirements-orchestration.txt

COPY scripts/ ./scripts/
COPY terraform/ ./terraform/

CMD ["/bin/bash"]
